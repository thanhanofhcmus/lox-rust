# ---------- Maps: literal, subscript, builtins ----------

import "std:map" as map;

# literal + subscript get
var m = %{ "a" => 1, "b" => 2, "c" => 3 };
assert(m["a"] == 1, "string key lookup");
assert(m["b"] == 2, "string key lookup 2");

# missing key returns nil
assert(m["nope"] == nil, "missing key yields nil");

# subscript set
m["d"] = 4;
assert(m["d"] == 4, "subscript assignment adds new key");
m["a"] = 99;
assert(m["a"] == 99, "subscript assignment overwrites");

# mixed-type keys (integer, float, bool, string)
var registry = %{
    "name" => "Gemini",
    100 => "Centurion",
    200 => 300,
    200.5 => 400,
    true => "Active",
};
assert(registry["name"] == "Gemini", "string key");
assert(registry[100] == "Centurion", "integer key");
assert(registry[200] == 300, "integer key 200");
assert(registry[200.5] == 400, "float key");
assert(registry[true] == "Active", "bool key");
assert(registry[false] == nil, "missing bool key yields nil");

# std:map module — length
assert(map::length(%{}) == 0, "empty map length");
assert(map::length(m) == 4, "map length");

# std:map module — keys / values
var km = %{ "a" => 1, "b" => 2, "c" => 3 };
assert(map::keys(km) == ["a", "b", "c"], "map::keys (BTreeMap ordering)");
assert(map::values(km) == [1, 2, 3], "map::values (BTreeMap ordering)");

# std:map module — insert returns the previous value when key existed
var old = map::insert(km, "a", 99);
assert(old == 1, "map::insert returns old value");
assert(km["a"] == 99, "map::insert updates value");

# The declared type must match the runtime behavior. While `insert` was typed
# `-> nil` the checker rejected `+` on its result, because `nil` has no
# arithmetic; the returned value was in fact the previous value all along.
assert(map::insert(km, "a", 100) + 1 == 100, "map::insert result is usable as a value");

# Absent key yields nil.
var fresh = %{};
assert(map::insert(fresh, "zzz", 1) == nil, "map::insert returns nil for a new key");

# std:map module — remove returns the value
var removed = map::remove(km, "b");
assert(removed == 2, "map::remove returns removed value");
assert(map::length(km) == 2, "map::remove decreases length");
assert(km["b"] == nil, "removed key now yields nil");
